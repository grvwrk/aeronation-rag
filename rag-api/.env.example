# ==============================================================================
# Aeronation RAG Pipeline - Environment Configuration Template (.env.example)
# Copy this file to '.env' and fill in your actual credentials and settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM & Service API Keys
# ------------------------------------------------------------------------------
# Groq API Key (default LLM model provider: openai/gpt-oss-20b)
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenAI API Key (required if LLM_MODEL_TYPE is configured as OPENAI)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Anthropic API Key (required if LLM_MODEL_TYPE is configured as ANTHROPIC)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Cohere API Key (required for node reranking via rerank-v4.0-fast)
COHERE_API_KEY=your_cohere_api_key_here

# Tavily API Key (required for online search fallback)
TAVILY_API_KEY=tvly-your_tavily_api_key_here


# ------------------------------------------------------------------------------
# 2. Qdrant Vector Store Configuration
# ------------------------------------------------------------------------------
# Qdrant cluster endpoint (e.g., http://localhost:6333 or Qdrant Cloud URL)
QDRANT_URL=http://localhost:6333

# Qdrant API Key (leave blank if running locally without authentication)
QDRANT_API_KEY=

# Default collection name
QDRANT_COLLECTION=rag_llm

# Vector distance metric (Cosine, Dot, Euclid, Manhattan)
VECTOR_DISTANCE=Cosine

# Hybrid search configuration (dense + sparse BM42 representation)
QDRANT_ENABLE_HYBRID=True
DENSE_VECTOR_NAME=text-dense
SPARSE_VECTOR_NAME=text-sparse-new
VECTOR_BATCH_SIZE=64


# ------------------------------------------------------------------------------
# 3. Embedding Engine Configuration
# ------------------------------------------------------------------------------
# Dense embedding model name (HuggingFace / FastEmbed ONNX format)
HF_EMBED=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Sparse embedding model for BM42 lexical weights
FASTEMBED_SPARSE_MODEL=Qdrant/bm42-all-minilm-l6-v2-attentions
FASTEMBED_CACHE_DIR=./.fastembed_cache
EMBEDDING_BATCH_SIZE=64


# ------------------------------------------------------------------------------
# 4. Ingestion Chunking & Local Persistence
# ------------------------------------------------------------------------------
# Token / character chunking bounds
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_MIN_CHUNK_SIZE=0

# Local persistence target directory for LlamaIndex storage artifacts
PERSIST_DIR=persist
PERSIST_COLLECTION_TYPE=rag_llm
MAX_RETRIES=3


# ------------------------------------------------------------------------------
# 5. AWS Credentials & S3 Storage (Optional for Local Dev / Required for AWS)
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# S3 buckets for index persistence and chat session logs
S3_PERSIST_BUCKET=aeronation-rag-test-log-and-chat-history
S3_LOGS_BUCKET=aeronation-rag-test-log-and-chat-history
S3_BASE_PREFIX=persist
S3_ENABLE_STAGING=True

# AWS Secrets Manager & CloudWatch Logging (optional)
SECRETS_MANAGER=aeronation/rag/test/api-keys
CLOUDWATCH_LOG_GROUP=altgan-log-group
CLOUDWATCH_LOG_STREAM=altgan-log-stream


# ------------------------------------------------------------------------------
# 6. RAG Retrieval & Generation Inference Parameters
# ------------------------------------------------------------------------------
RAG_SIMILARITY_CUTOFF=0.70
RAG_SIMILARITY_TOP_K=5
RAG_RERANKED_TOP_N=3
RAG_CITATION_CHUNK_SIZE=128
RAG_CITATION_CHUNK_OVERLAP=8
RAG_STREAMING=True
